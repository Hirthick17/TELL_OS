GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000
TRACE_MODE=true
# ─── Meta WhatsApp Cloud API (minimum required) ───────────────────────
META_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_verify_token_here

# ─── Instagram Messenger Platform (optional) ───────────────────────────
META_IG_ACCESS_TOKEN=your_instagram_access_token_here
META_IG_VERIFY_TOKEN=your_instagram_verify_token_here

# ─── MongoDB Atlas ────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# ─── Public URL (Render / Railway deployment URL) ─────────────────────
PUBLIC_URL=https://your-app.onrender.com

# ─── Admin API (missed-intents review queue) ──────────────────────────
# Set a strong random string. Leave blank to disable admin endpoints.
ADMIN_SECRET=your_admin_secret_here

NIM_KEY=your_nim_api_key_here